<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet para conectar al backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cámara para sacar foto a la firma -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.RecibosVina"
        android:usesCleartextTraffic="true">

        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-4478373683231277~3057073988" />

        <!-- Pantalla principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login patrón -->
        <activity
            android:name=".PatronLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login contratista -->
        <activity
            android:name=".ContratistaLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Panel patrón -->
        <activity
            android:name=".PatronPanelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Panel contratista -->
        <activity
            android:name=".ContratistaPanelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Política de privacidad -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Centro de ayuda -->
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
