<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="🍇 Registro de Patrón"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/azul_vina" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Registrate con tu nombre y el número de viñedo"
        android:textSize="13sp"
        android:textColor="#666" />

    <EditText
        android:textColor="#111111"
        android:id="@+id/etNombrePatron"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:hint="Nombre y apellido"
        android:background="@drawable/bg_input"
        android:padding="14dp" />

    <EditText
        android:textColor="#111111"
        android:id="@+id/etViniedo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:hint="Número de viñedo (ej: V-00123)"
        android:background="@drawable/bg_input"
        android:padding="14dp" />

    <Button
        android:id="@+id/btnRegistrarPatron"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="REGISTRARME"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/azul_vina" />

</LinearLayout>
