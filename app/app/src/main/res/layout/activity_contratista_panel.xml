<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🖋️ Tu firma"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/verde_ok" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Firmá en un papel en blanco, sacale una foto y subila. Así firmás tus recibos con tu firma real."
        android:textSize="13sp"
        android:textColor="#666" />

    <Button
        android:id="@+id/btnSubirFirma"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="📸 SUBIR MI FIRMA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/verde_ok" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginTop="22dp" />

    <Button
        android:id="@+id/btnVerRecibos"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="📄 VER MIS RECIBOS"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/azul_vina" />

    <TextView
        android:id="@+id/tvRecibos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textColor="#111"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:visibility="gone" />

</LinearLayout>
