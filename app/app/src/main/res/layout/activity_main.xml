<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:padding="24dp">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Logo Recibos Viña" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Recibos Viña"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/azul_vina" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Contratistas de Viñas y Frutales\nMendoza - Argentina"
        android:textSize="14sp"
        android:textColor="#666"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnPatron"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="50dp"
        android:text="🍇 SOY PATRÓN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/azul_vina" />

    <Button
        android:id="@+id/btnContratista"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="✍️ SOY CONTRATISTA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/verde_ok" />

</LinearLayout>
